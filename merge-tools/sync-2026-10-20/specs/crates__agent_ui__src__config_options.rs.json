{
  "file": "crates/agent_ui/src/config_options.rs",
  "blocks": {
    "1": [
      "    let options = options",
      "        .into_iter()",
      "        .take(MAX_CONFIG_OPTION_FUZZY_CANDIDATES)",
      "        .collect::<Vec<_>>();",
      "    model_search::search(options, query, executor, |index, option| {",
      "        (",
      "            StringMatchCandidate::new(index, option.name.clone()),",
      "            StringMatchCandidate::new(",
      "                index,",
      "                format!(",
      "                    \"{} {} {} {}\",",
      "                    option.name,",
      "                    option.group.as_deref().unwrap_or_default(),",
      "                    option.description.as_deref().unwrap_or_default(),",
      "                    option.value.0,",
      "                ),",
      "            ),",
      "        )",
      "    })",
      "    .await",
      "    .into_iter()",
      "    .take(MAX_CONFIG_OPTION_FUZZY_MATCHES)",
      "    .collect()"
    ]
  }
}
