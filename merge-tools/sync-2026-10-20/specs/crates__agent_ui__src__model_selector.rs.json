      "            let groups = futures::future::join_all(",
      "                index_map",
      "                    .into_iter()",
      "                    .take(MAX_MODEL_SELECTOR_GROUPS)",
      "                    .map(|(group_name, models)| {",
      "                        fuzzy_search_list(models, Some(group_name.0.clone()), &query, executor.clone())",
