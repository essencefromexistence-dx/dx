# Don't commit any secrets to the repo.
.env
.env.secret.toml

# `nix build` output
/result

# Visual test baseline images (these will be stored outside
# the repo in the future, but we don't haven't decided exactly
# where yet, so for now they get generated into a gitignored dir.)
/crates/zed/test_fixtures/visual_tests/

# Local documentation audit files
/december-2025-releases.md
/docs/december-2025-documentation-gaps.md

# Local Codex/runtime artifacts and reference caches
/.codex-*
/models/
/tools/

# Parked notes kept on disk but not in version control.
# Anchored at the repo root so every descendant is ignored.
/trash/

# Local inspiration/reference material.
# NOTE: this replaces the earlier per-child entries (/inspirations/21st-magic-mcp/,
# /inspirations/magicui/, /inspirations/shadcn-ui/), which ignored only those three
# folders by name. The trailing slash + leading slash anchors to the repo root and
# excludes the directory itself and EVERY descendant, so new subfolders are covered
# automatically and no per-child entry has to be added again.
/inspirations/

# Non-code folders parked out of version control. They stay on disk for local
# reference, but they are not part of the published dx codebase.
/web/
/zzz/
/merge-tools/
/.factory/
/.wezel/
# .agents/ is already ignored by the `.agents` rule above.

# NixOS integration test state
.nixos-test-history
/extensions/dx-icon
/docs

.local*
.cache
