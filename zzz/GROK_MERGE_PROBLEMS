  if ($binary -or $ext -in @('.png','.jpg','.jpeg','.gif','.ico','.wav','.svg','.woff','.woff2','.ttf')) {
    return @{ D='easy'; R='asset/binary → upstream (shared zed path)' }
  }
  if ($p -match 'LICENSE') { return @{ D='easy'; R='license → upstream form' } }
  if ($p -eq 'Cargo.lock' -or $p -match 'pnpm-lock|package-lock') {
    return @{ D='mechanical'; R='lockfile → take upstream then regenerate later' }
  }
  if ($p -eq 'Cargo.toml') { return @{ D='hard'; R='root workspace — STOP, need policy' } }
  if ($p -match '/Cargo.toml$' -and $churn -lt 200) {
    return @{ D='medium'; R='crate Cargo.toml' }
  }
  if ($ext -in @('.toml','.yml','.yaml','.txt') -and $churn -lt 200) {
    return @{ D='easy'; R='small config text' }
  }
  if ($ext -eq '.json' -and $p -match 'assets/(keymaps|settings)/') {
    return @{ D='hard'; R='keymap/settings — STOP' }
  }
  if ($ext -eq '.rs') {
    if ($churn -lt 50) { $d = 'medium'; $r = "small rust ~$churn" }
    elseif ($churn -lt 400) { $d = 'hard'; $r = "mod rust ~$churn" }
    else { $d = 'very hard'; $r = "large rust ~$churn" }
    if ($p -match 'crates/(zed|workspace|agent_ui|gpui|editor)/') {
      if ($d -eq 'medium') { $d = 'hard'; $r += ' [core]' }
      elseif ($d -eq 'hard') { $d = 'very hard'; $r += ' [core]' }
    }
    return @{ D=$d; R=$r }
  }
  if ($ext -in @('.json','.hbs','.proto','.scm','.sql')) {
    if ($churn -lt 100) { return @{ D='medium'; R='structured text' } }
    return @{ D='hard'; R='large structured text' }
  }
  if ($p -match '^script/' -or $ext -in @('.sh','.ps1','.py')) {
    return @{ D='medium'; R='script' }
  }
  if ($churn -lt 80) { return @{ D='medium'; R='misc small' } }
  return @{ D='hard'; R='misc larger' }
}

